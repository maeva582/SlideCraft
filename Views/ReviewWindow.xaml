<Window x:Class="SlideCraft.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlideCraft - Review summary"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">

    <!-- ================================================================
         REVIEW SUMMARY

         Cet écran répond à deux questions simples :
           • « Ma présentation est-elle prête ? » (taille, notes, transitions) ;
           • « Qu'est-ce que je viens de modifier ? » (historique annulable).
         Rien n'est modifié ici, sauf si l'on clique Undo ou Redo.
         ================================================================ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#6366F1" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <Style x:Key="StatLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="REVIEW"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6366F1" />
            <TextBlock Text="Is the presentation ready?"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,2,0,0" />
            <TextBlock Text="This page only counts and describes. It never changes your slides unless you press Undo or Redo."
                       FontSize="12.5"
                       Foreground="#374151"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>

                <TextBlock Text="SIZE AND READING TIME" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding SlideCountLabel}" Style="{StaticResource StatLine}" />
                <TextBlock Text="{Binding SlideWordCountLabel}" Style="{StaticResource StatLine}" />
                <TextBlock Text="{Binding NotesWordCountLabel}" Style="{StaticResource StatLine}" />
                <TextBlock Text="{Binding ReadingTimeLabel}" Style="{StaticResource StatLine}" />

                <TextBlock Text="WHAT MAY BE MISSING" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding NotesLabel}" Style="{StaticResource StatLine}" />
                <TextBlock Text="{Binding TransitionLabel}" Style="{StaticResource StatLine}" />

                <TextBlock Text="CHANGES (UNDO HISTORY)" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding HistoryExplanation}"
                           FontSize="12"
                           Foreground="#4B5563"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <ListBox ItemsSource="{Binding HistoryItems}"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="220"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="12.5"
                                           Foreground="#111827"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Text="Nothing has been changed yet."
                           FontSize="12.5"
                           FontStyle="Italic"
                           Foreground="#6B7280"
                           Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Undo and Redo act on the real presentation, here and in the editor."
                       FontSize="11.5"
                       Foreground="#6B7280"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Undo"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding UndoCommand}"
                        ToolTip="Undo the first change of the list (same as Ctrl+Z)" />
                <Button Content="Redo"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding RedoCommand}"
                        ToolTip="Redo the last undone change (same as Ctrl+Y)" />
                <Button Content="Close"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="Close this summary" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
