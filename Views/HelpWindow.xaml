<Window x:Class="SlideCraft.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlideCraft - Quick guide"
        Width="780"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">

    <!-- ================================================================
         GUIDE RAPIDE

         Écrit pour une personne qui n'a jamais utilisé de logiciel de
         présentation : chaque ligne dit à quoi sert la chose, pas comment
         elle est codée. Le texte reste volontairement simple et court.
         ================================================================ -->
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="10,0,0,6" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="QUICK GUIDE"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6366F1" />
            <TextBlock Text="What everything does"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,2,0,0" />
            <TextBlock Text="SlideCraft creates presentations on your own computer. Nothing is sent to the Internet, and nothing is generated by an artificial intelligence: the text, the pictures, the subtitles and the narration are yours."
                       Style="{StaticResource Body}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <StackPanel>

                <TextBlock Text="The tabs" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Home: add, duplicate or delete slides, copy and paste, undo, zoom." Style="{StaticResource Bullet}" />
                <TextBlock Text="Insert: text box, picture, video, shape, table, quiz, subtitles, and Import PowerPoint." Style="{StaticResource Bullet}" />
                <TextBlock Text="Design: background colours, slide layout, SmartSlide quality check." Style="{StaticResource Bullet}" />
                <TextBlock Text="Transitions: choose how the next slide appears during the show (None, Fade, Push, Wipe) and apply it to every slide." Style="{StaticResource Bullet}" />
                <TextBlock Text="Slide Show: start the show, set up the quiz game, choose the narration voice." Style="{StaticResource Bullet}" />
                <TextBlock Text="Review: check the quality of the slides, see the word count and the reading time, and undo or redo your changes." Style="{StaticResource Bullet}" />
                <TextBlock Text="View: zoom in or out, and show or hide the thumbnails, the properties panel and the notes." Style="{StaticResource Bullet}" />
                <TextBlock Text="Help: this guide." Style="{StaticResource Bullet}" />

                <TextBlock Text="Inserting a picture or a video" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Insert, then Pictures or Video, then choose a file on your computer. Resize it with the little square at its bottom right corner. In the slide show, a video plays with sound; in the editor it plays muted so you can check what it shows. When you save, the video is copied into a 'name_media' folder next to your .scraft file: move or share the two together."
                           Style="{StaticResource Body}" />

                <TextBlock Text="Transitions (how the next slide appears)" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="A transition is a very short effect played when you move from one slide to the next one during the show. It lasts less than half a second and is repeated every time that slide appears."
                           Style="{StaticResource Body}" />
                <TextBlock Text="Open the Transitions tab, click the slide you want in the list on the left, then click None, Fade, Push or Wipe. Apply to All gives the same effect to every slide. Press Preview (or F5) to see it for real: the effect only happens during the slide show, not in the editor."
                           Style="{StaticResource Bullet}" />
                <TextBlock Text="Fade means the slide appears gradually. Push means it slides in from the side. Wipe means it is revealed from one side, like a curtain. None means it appears instantly, which is the default."
                           Style="{StaticResource Bullet}" />
                <TextBlock Text="A transition is not an animation: it does not move the text inside a slide. SlideCraft does not do object animations yet."
                           Style="{StaticResource Bullet}" />

                <TextBlock Text="Opening a PowerPoint file" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Insert, then Import PowerPoint, and choose a .pptx file. SlideCraft keeps the text, the pictures, the videos, the tables, the background colours and the speaker notes. It also keeps the slide titles and grouped objects, and the Fade, Push and Wipe transitions. It does not keep PowerPoint animations, charts or SmartArt. Save the result as a .scraft file to keep your work."
                           Style="{StaticResource Body}" />

                <TextBlock Text="The narration voice" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="SlideCraft can read each slide aloud while it is shown. The voice comes from Windows, works without Internet, and is not an artificial intelligence."
                           Style="{StaticResource Body}" />
                <TextBlock Text="A voice speaks one language only. Open Slide Show, then Narration voice, pick the voice that matches the language of your slides, and press Hear this voice to check. If an English slide is read by a French voice, the words sound mixed up: that is the accent, not a translation."
                           Style="{StaticResource Bullet}" />
                <TextBlock Text="What is read: the narration script of the slide, or, if you wrote none, its title and its text boxes. Press V during the show to turn the voice off or on."
                           Style="{StaticResource Bullet}" />

                <TextBlock Text="Subtitles" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Insert, then Subtitles. You write both languages yourself: SlideCraft never translates. During the show, press T to show both languages, one of them, or nothing."
                           Style="{StaticResource Body}" />

                <TextBlock Text="The quiz game" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Insert, then Quiz, to write the questions. Slide Show, then Game Setup, to type the player names. The audience votes by raising a hand and the presenter clicks the answer: no phone, no network, no account."
                           Style="{StaticResource Body}" />

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Ctrl+N new, Ctrl+O open, Ctrl+S save, Ctrl+Z undo, Ctrl+Y redo, Delete remove the selected element, F5 start the slide show."
                           Style="{StaticResource Body}" />
                <TextBlock Text="During the show: arrows to move, N for your notes, V for the voice, T for the subtitles, Esc to go back to the editor."
                           Style="{StaticResource Body}" />

                <TextBlock Text="If something goes wrong" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="SlideCraft never deletes your file when an operation fails. If a file cannot be opened, a message explains why and the current presentation stays as it was. Save often with Ctrl+S: the .scraft file is the one you can reopen and edit."
                           Style="{StaticResource Body}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
