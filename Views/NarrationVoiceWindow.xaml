<Window x:Class="SlideCraft.Views.NarrationVoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlideCraft - Narration voice"
        Width="660"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">

    <!-- ================================================================
         CHOIX DE LA VOIX DE NARRATION

         Chaque voix de Windows ne parle qu'une langue. Cette fenêtre montre
         la liste complète, avec la langue de chacune, et permet d'écouter
         une phrase d'essai avant de choisir.
         ================================================================ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="NARRATION VOICE"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6366F1" />
            <TextBlock Text="Which voice reads your slides aloud?"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding Explanation}"
                       FontSize="12"
                       Foreground="#374151"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#EEF2FF"
                BorderBrush="#C7D2FE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,9"
                Margin="0,12,0,0">
            <TextBlock Text="{Binding WhatIsRead}"
                       FontSize="11.5"
                       Foreground="#312E81"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Liste des voix installées -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,12,0,0">
            <Grid>
                <ListBox ItemsSource="{Binding Voices}"
                         SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasVoices, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,5">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock FontSize="11.5"
                                           Foreground="#6B7280">
                                    <Run Text="{Binding Language, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Gender, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding NoVoiceMessage}"
                           FontSize="12"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="16"
                           Visibility="{Binding HasNoVoice, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Essai et message d'état -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Hear this voice"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="0"
                        Command="{Binding PreviewCommand}"
                        IsEnabled="{Binding HasVoices}" />
                <TextBlock Text="{Binding SelectedVoiceLabel}"
                           FontSize="11.5"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding PreviewStatus}"
                       FontSize="11.5"
                       Foreground="#4F46E5"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="CancelButton_Click" />
            <Button Content="Use this voice"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="UseButton_Click"
                    IsEnabled="{Binding HasVoices}" />
        </StackPanel>
    </Grid>
</Window>
