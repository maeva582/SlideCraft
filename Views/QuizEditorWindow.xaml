<Window x:Class="SlideCraft.Views.QuizEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlideCraft - Quiz"
        Width="620"
        Height="610"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">

    <!-- ================================================================
         ÉDITEUR DU QUIZ D'UNE DIAPOSITIVE

         Une diapositive porte au plus une question, affichée en fin de
         diapositive pendant la projection. Quatre emplacements de réponses
         suffisent ; les lignes laissées vides sont ignorées.
         ================================================================ -->
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="AnswerBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel>
            <TextBlock Text="QUIZ AT THE END OF THE SLIDE"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6366F1" />
            <TextBlock Text="{Binding SlideTitle, StringFormat=Slide: {0}}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0" />
            <TextBlock Text="During the slide show the question appears on screen. The room votes by a show of hands, then you click the answer (or press 1-4)."
                       FontSize="11.5"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Question" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,7"
                         FontSize="14"
                         BorderBrush="#CBD5E1"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="54"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Answers (mark the correct one)"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,6" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <RadioButton Grid.Row="0" Grid.Column="0"
                                 GroupName="CorrectAnswer"
                                 VerticalAlignment="Center"
                                 ToolTip="This is the correct answer"
                                 IsChecked="{Binding IsAnswer1Correct, Mode=TwoWay}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource AnswerBoxStyle}"
                             Margin="0,0,0,6"
                             Text="{Binding Answer1, UpdateSourceTrigger=PropertyChanged}" />

                    <RadioButton Grid.Row="1" Grid.Column="0"
                                 GroupName="CorrectAnswer"
                                 VerticalAlignment="Center"
                                 ToolTip="This is the correct answer"
                                 IsChecked="{Binding IsAnswer2Correct, Mode=TwoWay}" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource AnswerBoxStyle}"
                             Margin="0,0,0,6"
                             Text="{Binding Answer2, UpdateSourceTrigger=PropertyChanged}" />

                    <RadioButton Grid.Row="2" Grid.Column="0"
                                 GroupName="CorrectAnswer"
                                 VerticalAlignment="Center"
                                 ToolTip="This is the correct answer"
                                 IsChecked="{Binding IsAnswer3Correct, Mode=TwoWay}" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource AnswerBoxStyle}"
                             Margin="0,0,0,6"
                             Text="{Binding Answer3, UpdateSourceTrigger=PropertyChanged}" />

                    <RadioButton Grid.Row="3" Grid.Column="0"
                                 GroupName="CorrectAnswer"
                                 VerticalAlignment="Center"
                                 ToolTip="This is the correct answer"
                                 IsChecked="{Binding IsAnswer4Correct, Mode=TwoWay}" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource AnswerBoxStyle}"
                             Text="{Binding Answer4, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Points for a correct answer"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBox Width="70"
                             Padding="8,5"
                             Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0"
                    Content="Remove quiz"
                    IsEnabled="{Binding HasExistingQuiz}"
                    Click="Remove_Click"
                    ToolTip="Delete the quiz of this slide" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource DialogButtonStyle}"
                        Content="Clear"
                        Click="Clear_Click" />
                <Button Style="{StaticResource DialogButtonStyle}"
                        Content="Cancel"
                        IsCancel="True" />
                <Button Style="{StaticResource DialogButtonStyle}"
                        Content="Save quiz"
                        IsDefault="True"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderBrush="#4338CA"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
